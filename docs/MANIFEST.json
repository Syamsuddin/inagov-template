{
  "nama": "idds-ui-pack",
  "versi": "1.8.0",
  "tujuan": "bahan referensi UI untuk skill VCBD di Claude Code",
  "sistem_desain": "INA Digital Design System (IDDS)",
  "klasifikasi": "Dokumen PDF induk berlabel RAHASIA/internal. Paket ini turunan untuk pemakaian internal instansi. JANGAN dipublikasikan ke repo publik.",
  "brand_aktif": {
    "slug": "hss",
    "label": "Pemkab HSS",
    "status": "TERVALIDASI",
    "warna_dasar": "#0063a8",
    "accent": "#fff500",
    "sumber": "disampel dari berkas logo resmi (PNG) yang diunggah pengguna",
    "warna_pendukung": {
      "hijau_daun": "#00923f",
      "biru_terang": "#0075ba",
      "biru_atap": "#004a92",
      "kuning_emas": "#f8c300"
    },
    "catatan": "HSS belum punya Perda lambang daerah (Raperda Sept 2026); nilai bisa berubah bila Perda menetapkan spesifikasi berbeda"
  },
  "sumber_terverifikasi": [
    "https://design.inadigital.go.id (dokumentasi resmi)",
    "npm @idds/styles (token warna, radius, spacing, brand)",
    "npm @idds/react (kontrak varian komponen)",
    "repo tabler-icons-main v3.46.0 (unggahan pengguna) - geometri & indeks ikon",
    "arsip inter.zip Version 4.001;git-66647c0bb (unggahan pengguna) - metrik, sumbu, fitur OpenType",
    "Dokumentasi_INA_Digital_Design_System.pdf (176 hal, Oktober 2025)"
  ],
  "rute_pemuatan": {
    "selalu": [
      "docs/26_UI_CONVENTIONS.md"
    ],
    "menulis CSS/komponen": [
      "assets/idds-tokens.css",
      "assets/idds-utilities.css"
    ],
    "memilih warna teks": [
      "docs/data/aturan-kontras.json"
    ],
    "memilih ikon": [
      "docs/data/dosir-ikon-tabler.json"
    ],
    "menyetel font": [
      "docs/data/dosir-font-inter.json"
    ],
    "rujukan penuh": [
      "docs/data/dosir-ui-idds.json",
      "docs/data/dosir-kontras-idds.json",
      "docs/data/brand-hss.json"
    ],
    "TIDAK dimuat agen": [
      "docs/referensi/*"
    ],
    "mengubah token warna": [
      "docs/scripts/build-kontras.py (jalankan ulang + --check)"
    ],
    "membangun halaman admin": [
      "assets/idds-admin.css",
      "assets/idds-admin.js",
      "index.html (rujukan tata letak)",
      "disposisi.html (rujukan alur persetujuan + modal)",
      "cetak.html (rujukan lembar cetak)",
      "skm.html (rujukan Likert & fieldset)",
      "agenda.html (rujukan kalender)",
      "kinerja.html (rujukan tree view)",
      "dashboard-eksekutif.html (rujukan peta ubin)",
      "kebijakan-privasi.html (rujukan dokumen prosa + daftar isi)"
    ],
    "contoh halaman siap pakai": [
      "*.html"
    ],
    "membangun halaman publik (tanpa sidebar)": [
      "assets/idds-admin.css (blok Fase 6 .ina-public)",
      "publik-beranda.html (rujukan kerangka publik)"
    ],
    "membangun layar besar / kios": [
      "kios-antrian.html",
      "situation-room.html"
    ]
  },
